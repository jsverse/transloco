{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "outDir": "../../dist/out-tsc",
    "sourceMap": false,
    "declaration": true,
    "lib": ["ES2021"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2021",
    "allowSyntheticDefaultImports": true
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.spec.ts", "src/test-setup.ts", "vitest.config*.ts"]
}
