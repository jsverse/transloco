{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "outDir": "../../dist/out-tsc",
    "sourceMap": false,
    "declaration": false,
    "lib": ["es2022"],
    "module": "nodenext",
    "target": "ES2021",
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.spec.ts", "src/test-setup.ts", "vitest.config*.ts"]
}
