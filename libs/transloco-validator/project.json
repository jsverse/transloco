{
  "name": "transloco-validator",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/transloco-validator/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/transloco-validator",
        "main": "libs/transloco-validator/src/index.ts",
        "tsConfig": "libs/transloco-validator/tsconfig.lib.json",
        "assets": [
          "libs/transloco-validator/*.md",
          { "input": ".", "glob": "LICENSE", "output": "." }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/libs/transloco-validator"],
      "options": {
        "configFile": "libs/transloco-validator/vitest.config.ts"
      }
    }
  }
}
