{
  "name": "transloco-keys-manager",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/transloco-keys-manager/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["^build", "build-marker-esm"],
      "inputs": [
        "production",
        "^production",
        { "dependentTasksOutputFiles": "marker.{mjs,d.mts}" }
      ],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/transloco-keys-manager",
        "main": "libs/transloco-keys-manager/src/index.ts",
        "tsConfig": "libs/transloco-keys-manager/tsconfig.lib.json",
        "assets": [
          "libs/transloco-keys-manager/*.md",
          { "input": ".", "glob": "LICENSE", "output": "." },
          {
            "input": "tmp/transloco-keys-manager/marker-esm",
            "glob": "marker.{mjs,d.mts}",
            "output": "src/lib",
            "includeIgnoredFiles": true
          }
        ]
      }
    },
    "build-marker-esm": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/lib/marker.ts",
        "{projectRoot}/tsconfig.marker-esm.json",
        "{workspaceRoot}/tools/scripts/build-marker-esm.mts"
      ],
      "outputs": ["{workspaceRoot}/tmp/transloco-keys-manager/marker-esm"],
      "options": {
        "parallel": false,
        "commands": [
          {
            "command": "npx tsc -p libs/transloco-keys-manager/tsconfig.marker-esm.json"
          },
          {
            "command": "node tools/scripts/build-marker-esm.mts"
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/libs/transloco-keys-manager"],
      "options": {
        "configFile": "libs/transloco-keys-manager/vitest.config.ts"
      }
    }
  }
}
