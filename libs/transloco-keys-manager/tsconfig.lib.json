{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "outDir": "../../dist/out-tsc",
    "sourceMap": false,
    "declaration": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "target": "ES2021",
    "allowSyntheticDefaultImports": true
  },
  "include": ["**/*.ts"],
  "exclude": [
    "**/*.spec.ts",
    "**/tests/**",
    "src/test-setup.ts",
    "vitest.config*.ts"
  ]
}
