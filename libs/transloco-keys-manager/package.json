{
  "name": "@jsverse/transloco-keys-manager",
  "version": "9.0.0-alpha.4",
  "description": "Extract translatable keys from projects that uses Transloco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsverse/transloco"
  },
  "homepage": "https://jsverse.gitbook.io/transloco/tools/keys-manager-tkm",
  "bugs": "https://github.com/jsverse/transloco/issues",
  "exports": {
    "./marker": {
      "types": "./src/lib/marker.d.mts",
      "default": "./src/lib/marker.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "transloco-keys-manager": "./src/index.js"
  },
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "angular",
    "i18n",
    "translate",
    "angular translate",
    "transloco",
    "extract",
    "keys",
    "tool",
    "cli"
  ],
  "dependencies": {
    "@jsverse/angular-utils": "1.0.0-beta.6",
    "@jsverse/transloco-utils": "^9.0.0-alpha.4",
    "chalk": "6.0.0",
    "cheerio": "1.2.0",
    "cli-table3": "0.6.1",
    "command-line-args": "6.0.2",
    "command-line-usage": "7.0.4",
    "cosmiconfig": "10.0.0",
    "debug": "4.4.3",
    "deep-diff": "1.0.2",
    "flat": "6.0.1",
    "fs-extra": "11.4.0",
    "gettext-parser": "8.0.0",
    "glob": "13.0.6",
    "jsonc-parser": "3.3.1",
    "ora": "9.4.1",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/compiler": ">= 20.0.0 < 23.0.0",
    "typescript": ">= 5.8.0 < 7.0.0"
  }
}
