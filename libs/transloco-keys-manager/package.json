{
  "name": "@jsverse/transloco-keys-manager",
  "version": "9.0.0-alpha.4",
  "description": "Extract translatable keys from projects that uses Transloco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsverse/transloco"
  },
  "homepage": "https://jsverse.gitbook.io/transloco/tools/keys-manager-tkm",
  "bugs": "https://github.com/jsverse/transloco/issues",
  "type": "module",
  "exports": {
    "./marker": {
      "types": "./src/lib/marker.d.mts",
      "default": "./src/lib/marker.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "transloco-keys-manager": "src/index.js"
  },
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "angular",
    "i18n",
    "translate",
    "angular translate",
    "transloco",
    "extract",
    "keys",
    "tool",
    "cli"
  ],
  "dependencies": {
    "@jsverse/transloco-cli": "^9.0.0-alpha.4",
    "command-line-args": "6.0.2",
    "command-line-usage": "7.0.4",
    "tslib": "^2.8.1"
  }
}
