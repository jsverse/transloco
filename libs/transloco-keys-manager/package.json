{
  "name": "@jsverse/transloco-keys-manager",
  "version": "9.0.0-alpha.0",
  "description": "Extract translatable keys from projects that uses Transloco",
  "main": "src/lib/transloco-keys-manager.js",
  "types": "src/lib/transloco-keys-manager.d.ts",
  "exports": {
    ".": {
      "types": "./src/lib/transloco-keys-manager.d.ts",
      "default": "./src/lib/transloco-keys-manager.js"
    },
    "./marker": {
      "types": "./src/lib/marker.d.ts",
      "default": "./src/lib/marker.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "transloco-keys-manager": "src/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/jsverse/transloco/issues"
  },
  "homepage": "https://jsverse.gitbook.io/transloco/tools/keys-manager-tkm",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsverse/transloco"
  },
  "keywords": [
    "Angular",
    "i18n",
    "Translate",
    "Angular Translate",
    "Transloco",
    "Extract",
    "Keys",
    "Tool",
    "CLI",
    "Webpack"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@angular/compiler": ">= 20.0.0 < 23.0.0",
    "typescript": ">= 5.8.0 < 7.0.0"
  },
  "dependencies": {
    "@jsverse/angular-utils": "1.0.0-beta.6",
    "@jsverse/transloco-utils": "^9.0.0-alpha.0",
    "@phenomnomnominal/tsquery": "6.2.0",
    "chalk": "6.0.0",
    "cheerio": "1.2.0",
    "cli-table3": "0.6.1",
    "command-line-args": "6.0.2",
    "command-line-usage": "7.0.4",
    "cosmiconfig": "9.0.2",
    "debug": "4.4.3",
    "deep-diff": "1.0.2",
    "flat": "6.0.1",
    "fs-extra": "11.4.0",
    "gettext-parser": "8.0.0",
    "glob": "13.0.6",
    "jsonc-parser": "3.3.1",
    "ora": "9.4.1"
  }
}
