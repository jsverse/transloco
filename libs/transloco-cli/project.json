{
  "name": "transloco-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/transloco-cli/src",
  "projectType": "library",
  "tags": [],
  "implicitDependencies": ["!transloco"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/transloco-cli",
        "main": "libs/transloco-cli/src/index.ts",
        "tsConfig": "libs/transloco-cli/tsconfig.lib.json",
        "assets": [
          "libs/transloco-cli/*.md",
          {
            "input": ".",
            "glob": "LICENSE",
            "output": "."
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tools/vitest/**/*",
        { "env": "CI" },
        "{workspaceRoot}/libs/transloco/migrations/v9/cli-scripts-table.ts"
      ],
      "outputs": ["{workspaceRoot}/coverage/libs/transloco-cli"],
      "options": {
        "configFile": "libs/transloco-cli/vitest.config.ts"
      }
    },
    "test-golden": {
      "executor": "@nx/vitest:test",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "configFile": "libs/transloco-cli/vitest.config.golden.ts"
      }
    }
  }
}
