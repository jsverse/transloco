{
  "name": "transloco-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/transloco-cli/src",
  "projectType": "library",
  "tags": [],
  "implicitDependencies": ["!transloco"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/libs/transloco-cli"],
      "options": {
        "cwd": "libs/transloco-cli",
        "commands": ["tsc -p tsconfig.lib.json --noEmit", "tsdown"],
        "parallel": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{workspaceRoot}/coverage/libs/transloco-cli"],
      "options": {
        "configFile": "libs/transloco-cli/vitest.config.ts"
      }
    },
    "test-golden": {
      "executor": "@nx/vitest:test",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "configFile": "libs/transloco-cli/vitest.config.golden.ts"
      }
    }
  }
}
