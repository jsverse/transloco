{
  "name": "@jsverse/transloco-cli",
  "version": "9.0.0-alpha.4",
  "description": "The unified Transloco command line: extract, find, validate, optimize and scoped-libs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsverse/transloco"
  },
  "homepage": "https://jsverse.gitbook.io/transloco/",
  "bugs": {
    "url": "https://github.com/jsverse/transloco/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./internal/keys-manager": {
      "types": "./internal/keys-manager.d.ts",
      "default": "./internal/keys-manager.js"
    },
    "./internal/optimize": {
      "types": "./internal/optimize.d.ts",
      "default": "./internal/optimize.js"
    },
    "./internal/scoped-libs": {
      "types": "./internal/scoped-libs.d.ts",
      "default": "./internal/scoped-libs.js"
    },
    "./internal/validator": {
      "types": "./internal/validator.d.ts",
      "default": "./internal/validator.js"
    },
    "./package.json": "./package.json",
    "./internal/deprecation": {
      "types": "./internal/deprecation.d.ts",
      "default": "./internal/deprecation.js"
    }
  },
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "transloco": "bin.js"
  },
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "angular",
    "i18n",
    "translate",
    "angular translate",
    "transloco",
    "cli",
    "tool"
  ],
  "dependencies": {
    "@commander-js/extra-typings": "15.0.0",
    "@jsverse/angular-utils": "1.0.0-beta.6",
    "cheerio": "1.2.0",
    "chokidar": "^5.0.0",
    "cli-table3": "0.6.1",
    "commander": "15.0.0",
    "cosmiconfig": "10.0.0",
    "debug": "4.4.3",
    "deep-diff": "1.0.2",
    "find-duplicated-property-keys": "1.2.9",
    "flat": "6.0.1",
    "gettext-parser": "8.0.0",
    "glob": "13.0.6",
    "jsonc-parser": "3.3.1",
    "yocto-spinner": "1.2.2"
  },
  "peerDependencies": {
    "@angular/compiler": ">= 20.0.0 < 23.0.0",
    "typescript": ">= 5.8.0 < 7.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/compiler": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
