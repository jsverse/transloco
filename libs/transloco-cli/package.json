{
  "name": "@jsverse/transloco-cli",
  "version": "9.0.0-alpha.4",
  "description": "The unified Transloco command line: extract, find, validate, optimize, scoped-libs, join, split, migrate and init",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsverse/transloco"
  },
  "homepage": "https://jsverse.gitbook.io/transloco/",
  "bugs": {
    "url": "https://github.com/jsverse/transloco/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./internal/keys-manager": {
      "types": "./src/keys-manager/index.d.ts",
      "default": "./src/keys-manager/index.js"
    },
    "./internal/optimize": {
      "types": "./src/optimize/index.d.ts",
      "default": "./src/optimize/index.js"
    },
    "./internal/scoped-libs": {
      "types": "./src/scoped-libs/index.d.ts",
      "default": "./src/scoped-libs/index.js"
    },
    "./internal/validator": {
      "types": "./src/validator/index.d.ts",
      "default": "./src/validator/index.js"
    },
    "./package.json": "./package.json",
    "./internal/deprecation": {
      "types": "./src/deprecation/index.d.ts",
      "default": "./src/deprecation/index.js"
    },
    "./marker": {
      "types": "./src/marker.d.ts",
      "default": "./src/marker.js"
    },
    "./internal/translation-files": {
      "types": "./src/translation-files/index.d.ts",
      "default": "./src/translation-files/index.js"
    },
    "./internal/migrate": {
      "types": "./src/migrate/index.d.ts",
      "default": "./src/migrate/index.js"
    }
  },
  "main": "src/index.js",
  "bin": {
    "transloco": "src/bin.js"
  },
  "sideEffects": false,
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "angular",
    "i18n",
    "translate",
    "angular translate",
    "transloco",
    "cli",
    "tool",
    "keys manager",
    "extract",
    "find",
    "validate",
    "optimize",
    "scoped-libs",
    "join",
    "split",
    "migrate",
    "init"
  ],
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@commander-js/extra-typings": "15.0.0",
    "@jsverse/angular-utils": "1.0.0-beta.6",
    "cheerio": "1.2.0",
    "chokidar": "^5.0.0",
    "cli-table3": "0.6.1",
    "commander": "15.0.0",
    "cosmiconfig": "10.0.0",
    "debug": "4.4.3",
    "find-duplicated-property-keys": "1.2.9",
    "flat": "6.0.1",
    "gettext-parser": "8.0.0",
    "glob": "13.0.6",
    "jsonc-parser": "3.3.1",
    "yocto-spinner": "1.2.2"
  },
  "peerDependencies": {
    "@angular/compiler": ">= 20.0.0 < 23.0.0",
    "typescript": ">= 5.8.0 < 7.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/compiler": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
