{
  "$schema": "http://json-schema.org/schema",
  "$id": "SchematicsTransloco",
  "title": "Adds Transloco to a project",
  "type": "object",
  "properties": {
    "langs": {
      "description": "The languages of the project.",
      "x-prompt": "\uD83C\uDF0D Which languages do you need?",
      "type": "string",
      "default": "en, es",
      "alias": "la"
    },
    "loader": {
      "description": "The loader strategy for the translate files.",
      "type": "string",
      "default": "Http",
      "enum": ["Http", "Webpack"],
      "alias": "lo"
    },
    "translateType": {
      "description": "The translation files type.",
      "type": "string",
      "default": "JSON",
      "enum": ["JSON", "Typescript"],
      "alias": "t"
    },
    "path": {
      "type": "string",
      "description": "Translation files path (auto-detects public/ for Angular 18+)",
      "alias": "p"
    },
    "project": {
      "description": "The project name.",
      "type": "string",
      "$default": {
        "$source": "projectName"
      }
    },
    "module": {
      "description": "The root module name.",
      "type": "string",
      "default": "app"
    }
  },
  "required": []
}
