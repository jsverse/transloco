{
  "name": "@jsverse/transloco",
  "version": "8.4.0",
  "description": "The internationalization (i18n) library for Angular",
  "schematics": "./schematics/collection.json",
  "ng-update": {
    "migrations": "./migrations/migration.json",
    "packageGroup": [
      "@jsverse/transloco",
      "@jsverse/transloco-locale",
      "@jsverse/transloco-messageformat",
      "@jsverse/transloco-persist-lang",
      "@jsverse/transloco-persist-translations",
      "@jsverse/transloco-preload-langs",
      "@jsverse/transloco-schematics",
      "@jsverse/transloco-scoped-libs",
      "@jsverse/transloco-utils",
      "@jsverse/transloco-optimize",
      "@jsverse/transloco-validator",
      "@jsverse/transloco-keys-manager"
    ]
  },
  "exports": {
    "./schematics/*": "./schematics/*",
    "./schematics-core/*": "./schematics-core/*",
    "./migrations/*": "./migrations/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/jsverse/transloco/issues"
  },
  "homepage": "https://jsverse.gitbook.io/transloco/",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsverse/transloco"
  },
  "keywords": [
    "Angular",
    "i18n",
    "Translate",
    "Angular Translate",
    "Transloco",
    "Schematics",
    "Angular CLI"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@angular/core": ">=20.0.0",
    "rxjs": "^6.5.3 || ^7.4.0"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "@jsverse/utils": "1.0.0-beta.5",
    "@jsverse/transloco-utils": "^8.4.0"
  },
  "sideEffects": false
}
